# Copie para .env e ajuste. O docker-compose já injeta estes valores.

# Postgres. Em produção (Render/Railway) esta variável vem pronta do painel.
DATABASE_URL=postgresql+psycopg://painel:painel@localhost:5432/painel

# Segredo do JWT. Em produção, gere um novo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SEGREDO_JWT=troque-isto-em-producao-nao-use-o-valor-do-exemplo

# Minutos de validade do token de acesso.
EXPIRACAO_MINUTOS=480

# Origens liberadas no CORS, separadas por vírgula.
ORIGENS_LIBERADAS=http://localhost:5173
